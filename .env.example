# Local development only. Copy to .env; never commit real credentials.
COMPOSE_PROJECT_NAME=action-gate-standalone
APP_VERSION=0.2.0
APP_ENV=local
APP_HOST=ai-control-proxy.localhost
APP_BIND=0.0.0.0
APP_PORT=8000

# Local HTTP port published by Traefik.
TRAEFIK_HTTP_PORT=80
# MCP ingress port inside the compose network. The client-facing endpoint is Traefik:/mcp.
APP_MCP_PORT=8010
# Hostnames the MCP registry is allowed to connect to. A connection outside this list is refused at
# bootstrap, so a URL typed into a form can never become an outbound destination.
APP_MCP_ALLOWED_HOSTS=documents-mcp,outbox-mcp,tickets-mcp
# Endpoint the scenario client and the acceptance driver talk to. The client runs inside the
# gate-mcp container, so it reaches the ingress through Traefik by service name. From the host the
# same endpoint is http://127.0.0.1/mcp.
DEMO_MCP_ENDPOINT=http://traefik/mcp
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_IMAGE=traefik:v3.6
PYTHON_IMAGE=python:3.13-slim-bookworm
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine

# postgres is the durable source of truth; memory is for tests and loses everything on restart.
APP_STORAGE=postgres
APP_RUNTIME_CACHE=redis
APP_DB_POOL_SIZE=8
# Keyed hashes for audit and idempotency. Change it locally; a real deployment supplies its own
# secret and never keeps the default. It is not an encryption key for stored content.
APP_HASH_SALT=local-development-salt-change-me

# Synthetic local database credentials, not production credentials.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=action_gate
POSTGRES_USER=action_gate
POSTGRES_PASSWORD=local_action_gate_only

# Redis is disposable runtime storage, not the durable source of truth.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_MAXMEMORY=128mb

# Opt-in semantic provider (OpenAI-compatible chat endpoint). Leave empty to keep the provider
# profile unavailable; the gate then fails closed unless policy explicitly allows degraded mode.
# Adding real credentials and external calls is the owner's decision, not this file's default.
DETECTOR_PROVIDER_BASE_URL=
DETECTOR_PROVIDER_API_KEY=
DETECTOR_PROVIDER_MODEL=
DETECTOR_PROVIDER_TIMEOUT_MS=8000

# Real OpenAI Responses proxy. Empty key reuses DETECTOR_PROVIDER_API_KEY on the server.
# Model allowlist comes from the active panel policy; no key is accepted from request JSON.
OPENAI_API_KEY=
# Empty follows the active release default (currently the labelled offline baseline).
# Use provider-chat-v1 only when the real semantic provider and its time budget are configured.
MODEL_PROXY_DETECTOR_PROFILE=
